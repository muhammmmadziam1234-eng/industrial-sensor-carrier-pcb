(version 1)
(rule "Meridian copper clearance" (constraint clearance (min 0.254mm)))
(rule "Meridian signal track" (constraint track_width (min 0.254mm)))
(rule "Meridian power and load track"
  (condition "A.NetName == '/3V3' || A.NetName == '/CTRL_3V3' || A.NetName == '/AUX_3V3' || A.NetName == '/GND' || A.NetName == '/LOAD0' || A.NetName == '/LOAD1'")
  (constraint track_width (min 0.508mm)))
(rule "Meridian via drill" (constraint hole_size (min 0.30mm)) (condition "A.Type == 'Via'"))
